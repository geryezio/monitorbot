# ── Telegram Bot ────────────────────────────────────────────────
# Bot token from @BotFather. Copy this file to .env and put the real values there.
# Never store real credentials in this file — .env.example is committed to git.
BOT_TOKEN=

# Admin chat ID for automatic update notifications (optional).
# Leave empty to skip the periodic notification.
ADMIN_CHAT_ID=

# Interval for automatic update checks, in seconds (default: 86400 = 24 hours)
UPDATE_INTERVAL_SECONDS=86400
